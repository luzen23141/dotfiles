#!/bin/zsh

: "${DOTFILES:=$HOME/dotfiles}"
source "$DOTFILES"/helperFunc/envHelper
source "$DOTFILES"/helperFunc/gitBranch

usage() {
  echo "使用方法:"
  echo "1. 只提供一個分支縮寫時，將當前分支寫入對應的 git config："
  for k v in ${(kv)branch_config_keys}; do
    echo "   $k => $v"
  done
  echo "2. 提供兩個參數時：鍵為分支縮寫則寫入 git config，否則寫入 .aConfig。"
  echo ""
  echo "範例："
  echo "    a set m          # 將當前分支設定為 a.mainBranch"
  echo "    a set d develop  # 將 a.devBranch 設定為 develop"
  echo "    a set t2c 0      # 將 .aConfig 的 t2c 設定為 0"
  echo ""
  exit 1
}

# 檢查參數數量（最少 1 個，最多 2 個）
if [[ $# -lt 1 ]] || [[ $# -gt 2 ]]; then
  usage
fi

key=$1
git_key=${branch_config_keys[$key]}

# 處理單一參數的情況：值為當前分支
if [[ $# -eq 1 ]]; then
  if [[ -z $git_key ]]; then
    echo "錯誤：參數 '$key' 不是分支縮寫（${(k)branch_config_keys}）。"
    exit 1
  fi
  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "錯誤：目前不在 Git 倉庫中。"
    exit 1
  fi
  value=$(git rev-parse --abbrev-ref HEAD)
else
  value=$2
fi

if [[ -n $git_key ]]; then
  git config "$git_key" "$value" && echo "$git_key=$value"
else
  set_env_value "$key" "$value"
fi
